%% LPPL 1.3c or later; part of lumenbook.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lumen-mark}[2026/11/09 v1.2 Bilingual reading annotations]
\RequirePackage{xcolor,iftex,etoolbox}
\definecolor{LumenMarkYellow}{HTML}{FFF0B5}
\definecolor{LumenMarkGreen}{HTML}{DCEFE1}
\definecolor{LumenMarkBlue}{HTML}{DFECF8}
\definecolor{LumenMarkRose}{HTML}{F7DFE4}
\definecolor{LumenMarkViolet}{HTML}{EBE3F5}
\ifdefstring{\lumen@theme}{mono}{%
  \colorlet{LumenMarkYellow}{black!15}\colorlet{LumenMarkGreen}{black!10}
  \colorlet{LumenMarkBlue}{black!8}\colorlet{LumenMarkRose}{black!18}
  \colorlet{LumenMarkViolet}{black!12}}{}

\ifXeTeX
  \RequirePackage[normalem]{xeCJKfntef}
  \NewDocumentCommand{\textul}{O{LumenAccent} m}{%
    \CJKunderline[format=\color{#1}]{#2}}
  \NewDocumentCommand{\textwave}{O{LumenWarm} m}{%
    \CJKunderwave[format=\color{#1}]{#2}}
  \NewDocumentCommand{\textstrike}{O{LumenMuted} m}{%
    \CJKsout[format=\color{#1}]{#2}}
  \NewDocumentCommand{\textmark}{O{LumenMarkYellow} m}{%
    \CJKunderanyline{.6ex}{\color{#1}\rule{.2em}{2.4ex}}{#2}}
\else
  \RequirePackage{luacolor,lua-ul}
  \NewDocumentCommand{\textul}{O{LumenAccent} m}{\underLine[color={#1}]{#2}}
  \NewDocumentCommand{\textstrike}{O{LumenMuted} m}{\strikeThrough[#1]{#2}}
  \NewDocumentCommand{\textmark}{O{LumenMarkYellow} m}{\highLight[#1]{#2}}
  \newunderlinetype\lumen@wave
    [\lumen@wavemodel/\lumen@wavespec/\f@size]{%
      \color{\lumen@wavecolor}\leaders\hbox{\lower.75ex\hbox{%
        \begin{tikzpicture}[x=1pt,y=1pt,baseline=0pt]
          \draw[line width=.35pt] (0,0) .. controls (1,1) and (2,1) .. (3,0)
            .. controls (4,-1) and (5,-1) .. (6,0);
        \end{tikzpicture}}}}
  \NewDocumentCommand{\textwave}{O{LumenWarm} m}{\begingroup
    \def\lumen@wavecolor{#1}%
    \extractcolorspecs{#1}\lumen@wavemodel\lumen@wavespec
    \lumen@wave #2\endgroup}
\fi
\NewDocumentCommand{\textaccent}{O{LumenAccent} m}{\textcolor{#1}{#2}}

% Keep mathematics in a math-aware, non-breaking box. Every math style is
% preserved, including when the command appears in a subscript.
\newcommand{\lumen@mathmark}[3]{{\setlength{\fboxsep}{2pt}%
  \colorbox{#1}{$\m@th#2#3$}}}
\NewDocumentCommand{\mathmark}{O{LumenMarkBlue} m}{\ensuremath{%
  \mathchoice{\lumen@mathmark{#1}{\displaystyle}{#2}}%
    {\lumen@mathmark{#1}{\textstyle}{#2}}%
    {\lumen@mathmark{#1}{\scriptstyle}{#2}}%
    {\lumen@mathmark{#1}{\scriptscriptstyle}{#2}}}}

% A long colored passage can contain paragraphs, lists and display math.
\NewDocumentEnvironment{markblock}{O{LumenMarkBlue} O{}}{%
  \begin{tcolorbox}[lumen panel,colback={#1},colbacktitle={#1},
    coltitle=LumenInk,borderline west={1.3pt}{0pt}{LumenMuted!55!white},title={#2}]}
  {\end{tcolorbox}}
\NewDocumentCommand{\annotate}{O{LumenAccent} o m +m}{%
  \textul[#1]{#3}%
  \IfNoValueTF{#2}{\sn{#4}}{\sn[#2]{#4}}}

% PDF outlines retain plain text, including when a color argument is used.
\pdfstringdefDisableCommands{%
  \RenewExpandableDocumentCommand{\textul}{O{} m}{#2}%
  \RenewExpandableDocumentCommand{\textwave}{O{} m}{#2}%
  \RenewExpandableDocumentCommand{\textstrike}{O{} m}{#2}%
  \RenewExpandableDocumentCommand{\textmark}{O{} m}{#2}%
  \RenewExpandableDocumentCommand{\textaccent}{O{} m}{#2}}
\endinput
